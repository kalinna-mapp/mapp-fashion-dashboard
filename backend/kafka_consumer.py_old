# kafka_consumer.py
# Real Mapp Data Stream consumer via Confluent Kafka.
# Only used when USE_MOCK=false in .env.
#
# Field names below match standard Mapp Intelligence Data Stream output.
# Verify field names for your account in:
#   Mapp Intelligence → Data Streams → [your stream] → Connection Information
# Reference: docs/KAFKA_FIELDS.md

from confluent_kafka import Consumer, KafkaError
import json
import asyncio
from config import settings


def build_kafka_config() -> dict:
    return {
        "bootstrap.servers": settings.kafka_bootstrap_servers,
        "group.id": settings.kafka_group_id,
        "auto.offset.reset": "latest",
        "security.protocol": "SASL_SSL",
        "sasl.mechanism": "SCRAM-SHA-256",
        "sasl.username": settings.kafka_username,
        "sasl.password": settings.kafka_password,
    }


def parse_event(raw: dict) -> dict | None:
    """
    Normalise a raw Mapp Kafka event into the internal dashboard format.
    Returns None for events we do not need.
    """
    event_type = raw.get("eventType", "")

    if event_type == "page":
        return {
            "interaction": "view",
            "product": {
                "name":     raw.get("productName", "Unknown Product"),
                "category": raw.get("productCategory") or raw.get("contentGroup", "Other"),
                "price":    float(raw.get("productCost", 0)),
                "emoji":    "📄",  # frontend maps category → emoji
            },
            "sessionId": raw.get("sessionId", ""),
            "timestamp": raw.get("timestamp", ""),
        }

    if event_type == "basket" and raw.get("basketStatus") == "add":
        return {
            "interaction": "cart",
            "product": {
                "name":     raw.get("productName", "Unknown Product"),
                "category": raw.get("productCategory", "Other"),
                "price":    float(raw.get("productCost", 0)),
                "emoji":    "📄",
            },
            "basketValue": float(raw.get("basketValue", 0)),
            "basketItems": int(raw.get("basketItems", 1)),
            "sessionId":   raw.get("sessionId", ""),
            "timestamp":   raw.get("timestamp", ""),
        }

    if event_type == "order" and raw.get("orderStatus") == "conf":
        return {
            "interaction": "buy",
            "product": {
                "name":     raw.get("productName", "Unknown Product"),
                "category": raw.get("productCategory", "Other"),
                "price":    float(raw.get("productCost", 0)),
                "emoji":    "📄",
            },
            "orderValue":  float(raw.get("orderValue", 0)),
            "basketItems": int(raw.get("basketItems", 1)),
            "sessionId":   raw.get("sessionId", ""),
            "timestamp":   raw.get("timestamp", ""),
        }

    return None  # event type not relevant for this dashboard


async def consume(queue: asyncio.Queue):
    """
    Async Kafka consumer loop.
    Parsed events are placed on `queue` for the WebSocket broadcaster.
    """
    consumer = Consumer(build_kafka_config())
    consumer.subscribe([settings.kafka_topic])

    loop = asyncio.get_event_loop()

    try:
        while True:
            msg = await loop.run_in_executor(None, consumer.poll, 1.0)

            if msg is None:
                continue
            if msg.error():
                if msg.error().code() != KafkaError._PARTITION_EOF:
                    print(f"[Kafka] Error: {msg.error()}")
                continue

            try:
                raw = json.loads(msg.value().decode("utf-8"))
                event = parse_event(raw)
                if event:
                    await queue.put(event)
            except Exception as e:
                print(f"[Kafka] Parse error: {e}")

    finally:
        consumer.close()
