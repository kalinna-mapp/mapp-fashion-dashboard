# ─────────────────────────────────────────────────────────────────────────────
# Mapp Fashion Dashboard — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Mode ──────────────────────────────────────────────────────────────────────
# true  → use mock_stream.py  (no Kafka credentials needed, great for dev)
# false → use real Mapp Data Stream via Kafka
USE_MOCK=true

# ── Mapp Data Stream (Kafka) ───────────────────────────────────────────────────
# Find these in Mapp Intelligence → Data Streams → Connection Information
KAFKA_BOOTSTRAP_SERVERS=your-kafka-host:9093
KAFKA_USERNAME=your-username
KAFKA_PASSWORD=your-password
KAFKA_TOPIC=your-topic-name
KAFKA_GROUP_ID=fashion-dashboard-consumer

# ── Mapp Analytics API (historical data — not yet wired) ──────────────────────
# Activate in Mapp Intelligence → Settings → API Client IDs
MAPP_CLIENT_ID=your-client-id
MAPP_CLIENT_SECRET=your-client-secret
MAPP_API_BASE_URL=https://intelligence.eu.mapp.com/analytics/api

# Report IDs, element IDs and field names are configured in backend/mapp_reports.yaml — not here.

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173
